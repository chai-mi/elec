{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "elec",
  "main": "src/workers.ts",
  "compatibility_date": "2026-08-04",
  "workers_dev": false,
  "cache": {
    "enabled": true,
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
    },
  },
  "assets": {
    "directory": "dist",
    "html_handling": "drop-trailing-slash",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "elec",
      "database_id": "53d81a00-e326-4bac-8940-8b9020db85d9",
      "migrations_dir": "migrations",
      "migrations_pattern": "migrations/*/migration.sql",
    },
  ],
  "workflows": [
    {
      "name": "elec",
      "binding": "Elec",
      "class_name": "Elec",
      "schedules": ["0 */3 * * *"],
    },
  ],
  "vars": {
    "roomids": [418, 540, 501, 502, 503, 504, 505],
  },
}
