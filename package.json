{
  "name": "elec",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler d1 migrations apply elec --local && wrangler dev",
    "deploy": "astro build && wrangler d1 migrations apply elec --remote && wrangler deploy",
    "gen-db": "drizzle-kit generate",
    "gen-types": "wrangler types"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.1",
    "@hono/zod-validator": "^0.8.0",
    "@negrel/webpush": "npm:@jsr/negrel__webpush@^0.5.0",
    "@std/encoding": "npm:@jsr/std__encoding@^1.0.11",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.2",
    "chart.js": "^4.5.1",
    "daisyui": "^5.7.18",
    "drizzle-kit": "^1.0.0-rc.5-ab785fc",
    "drizzle-orm": "^1.0.0-rc.5-ab785fc",
    "es-toolkit": "^1.51.0",
    "hono": "^4.13.3",
    "tailwindcss": "^4.3.3",
    "wrangler": "^4.124.0",
    "zod": "^4.4.3"
  }
}
