---
import Add from "@/assets/Add.svg";
import Subscription from "@/components/Subscription.astro";
---

<div class="fab">
    <div tabindex="0" role="button" class="btn btn-lg btn-circle btn-primary">
        <Add />
    </div>

    <div class="fab-close">
        <span class="btn btn-circle btn-lg btn-error">✕</span>
    </div>

    <div>
        订阅
        <button class="btn btn-lg btn-circle" popovertarget="modal_1">
            S
        </button>
    </div>
</div>

<dialog id="modal_1" class="modal modal-bottom sm:modal-middle" popover>
    <div class="modal-box">
        <h3 class="text-lg font-bold">订阅当前选择的房间</h3>
        <p class="py-4">
            通过订阅，当房间的电量接近 0 时，你会收到通知
            <br />
            无需打开网页！
        </p>
        <form method="dialog">
            <Subscription />
        </form>
    </div>
    <div class="modal-backdrop">
        <button popovertarget="modal_1" popovertargetaction="hide">
            close
        </button>
    </div>
</dialog>
